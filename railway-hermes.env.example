# Optional non-interactive input for ./scripts/deploy.sh --yes
# Do not commit a filled copy of this file.

PROJECT_NAME=hermes-agent
SERVICE_NAME=hermes
REPO=qf1lzx/railway-hermes-oauth-image

# Gateway — Telegram is the easiest always-on channel.
TELEGRAM_BOT_TOKEN=...
TELEGRAM_ALLOWED_USERS=123456789
GATEWAY_ALLOW_ALL_USERS=false

# OAuth/subscription providers to bootstrap inside Railway.
HERMES_OAUTH_PROVIDERS=nous,openai-codex

# Recommended subscription-duo routing.
HERMES_MAIN_PROVIDER=openai-codex
HERMES_MAIN_MODEL=openai/gpt-5.4
HERMES_DELEGATION_PROVIDER=nous
HERMES_DELEGATION_MODEL=moonshotai/kimi-k2.6
HERMES_DELEGATION_BASE_URL=https://inference-api.nousresearch.com/v1
HERMES_AUX_PROVIDER=nous
HERMES_AUX_MODEL=google/gemini-3.1-flash-lite-preview
HERMES_AUX_BASE_URL=https://inference-api.nousresearch.com/v1
HERMES_AUX_CONTEXT_LENGTH=1048576

# Optional API-key providers.
# OPENROUTER_API_KEY=...
# ANTHROPIC_API_KEY=...
# OPENAI_API_KEY=...
# GOOGLE_API_KEY=...
# GEMINI_API_KEY=...
# DEEPSEEK_API_KEY=...
# XAI_API_KEY=...
# GROQ_API_KEY=...
# MISTRAL_API_KEY=...
# COPILOT_GITHUB_TOKEN=...

# Optional memory/tooling.
# HONCHO_API_KEY=...
# HERMES_MEMORY_PROVIDER=honcho
# HERMES_MEMORY_ENABLED=true
# GBRAIN_API_KEY=...

# Optional: Google Drive workspace collaboration.
# For client deployments, set a client-specific folder ID or leave sync disabled.
HERMES_SHARED_STATE_SYNC=none
# HERMES_WORKSPACE_DRIVE_FOLDER_ID=...
# GOOGLE_TOKEN_JSON=...
# GOOGLE_CLIENT_SECRET_JSON=...

# gstack client workflow bootstrap.
GSTACK_AUTO_SETUP=true
GSTACK_HOSTS=codex,claude
GSTACK_TEAM_MODE=false
GSTACK_SKILL_PREFIX=false
GSTACK_PLAYWRIGHT_BROWSERS_PATH=/tmp/ms-playwright
GSTACK_CLEAN_PLAYWRIGHT_CACHE=true
# CLIENT_NAME=Acme Corp
# CLIENT_SLUG=acme
