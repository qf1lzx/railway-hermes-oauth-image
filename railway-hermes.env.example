# Copy to railway-hermes.env, fill secrets, then base64 encode into HERMES_ENV_B64.
LLM_MODEL=openai/gpt-5.4
HERMES_MODEL_PROVIDER=openai-codex

# Telegram is the easiest always-on channel.
TELEGRAM_BOT_TOKEN=...
GATEWAY_ALLOW_ALL_USERS=false

# Optional: pre-authorize only your Telegram user id.
# TELEGRAM_ALLOWED_USERS=123456789
