# Copy to railway-hermes.env, fill secrets, then base64 encode into HERMES_ENV_B64.
LLM_MODEL=openai/gpt-5.4
HERMES_MODEL_PROVIDER=openai-codex

# Telegram is the easiest always-on channel.
TELEGRAM_BOT_TOKEN=...
GATEWAY_ALLOW_ALL_USERS=false

# Optional: Google Drive workspace collaboration.
# The setup scripts default the folder ID to Nick's Hermes Shared Workspace.
# Paste these as Railway variables, do not commit filled values here.
HERMES_WORKSPACE_DRIVE_FOLDER_ID=10Io92h6D936VcajyNYJJ9RYFkfKYQyXV
HERMES_SHARED_STATE_SYNC=drive
# GOOGLE_TOKEN_JSON=...
# GOOGLE_CLIENT_SECRET_JSON=...

# Optional: gstack client workflow bootstrap.
GSTACK_AUTO_SETUP=true
GSTACK_HOSTS=codex,claude
GSTACK_TEAM_MODE=false
GSTACK_SKILL_PREFIX=false
GSTACK_PLAYWRIGHT_BROWSERS_PATH=/tmp/ms-playwright
GSTACK_CLEAN_PLAYWRIGHT_CACHE=true
# CLIENT_NAME=Acme Corp
# CLIENT_SLUG=acme

# Optional: pre-authorize only your Telegram user id.
# TELEGRAM_ALLOWED_USERS=123456789
